# ─── App ─────────────────────────────────────────────────────────────────────

# development | production
APP_ENV=development

# Port yang dipakai server Go, default 8080
APP_PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────

# Connection string ke Supabase (atau PostgreSQL lain)
# Ambil dari: Supabase dashboard → Project Settings → Database → Connection string → Direct
# Wajib ada ?sslmode=require kalau pakai Supabase
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require

# ─── JWT ─────────────────────────────────────────────────────────────────────

# Secret key buat sign JWT token — isi dengan string random panjang, jangan pakai "secret"
# Generate contoh: openssl rand -hex 32
JWT_SECRET=ganti_dengan_random_string_panjang_dan_rahasia

# Durasi token berlaku — format Go duration: 24h, 48h, 7d tidak valid → pakai 168h (7 hari)
JWT_EXPIRES_IN=24h

# ─── Redis ───────────────────────────────────────────────────────────────────

# Dipakai buat Asyncq (background job: WA reminder, email verification)
# Pakai Upstash Redis (gratis): https://upstash.com
# Format: redis://default:[PASSWORD]@[HOST]:[PORT]
REDIS_URL=redis://default:[PASSWORD]@[HOST].upstash.io:6379

# ─── Fonnte (WhatsApp Notification) ──────────────────────────────────────────

# Token API Fonnte buat kirim notifikasi WA ke customer
# Daftar di: https://fonnte.com
# Kalau dikosongkan, notifikasi WA di-skip (tidak crash)
FONNTE_TOKEN=

# ─── Resend (Transactional Email) ────────────────────────────────────────────

# API key dari Resend buat kirim email verifikasi
# Daftar di: https://resend.com → Create API Key
# Kalau dikosongkan, email di-skip (tidak crash)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ─── Frontend URL ─────────────────────────────────────────────────────────────

# URL frontend — dipakai untuk:
# 1. Generate link verifikasi email yang dikirim ke user
# 2. Redirect setelah verify-email berhasil/gagal
# Dev: http://localhost:3000
# Production: https://bengkelhub.vercel.app
APP_BASE_URL=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────────────────────

# Origin yang diperbolehkan akses API ini (comma-separated, tanpa spasi)
# Dev: http://localhost:3000
# Production: isi URL frontend production
APP_CORS_ORIGINS=http://localhost:3000